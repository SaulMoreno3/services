---
export interface TimelineItem {
  date: string;
  title: string;
  description: string;
  type: 'education' | 'work' | 'project' | 'certification';
  details?: string[];
}

export interface Props {
  items: TimelineItem[];
  title?: string;
}

const { items, title = "Experiencia" } = Astro.props;

const typeConfig = {
  education: { 
    icon: 'academic-cap', 
    color: 'bg-blue-100 border-blue-500', 
    iconColor: 'text-blue-600 
  },
  work: { 
    icon: 'briefcase', 
    color: 'bg-green-100 border-green-500', 
    iconColor: 'text-green-600 
  },
  project: { 
    icon: 'code', 
    color: 'bg-purple-100 border-purple-500', 
    iconColor: 'text-purple-600 
  },
  certification: { 
    icon: 'badge-check', 
    color: 'bg-yellow-100 border-yellow-500', 
    iconColor: 'text-yellow-600 
  }
};

const iconSvg = {
  'academic-cap': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>`,
  'briefcase': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0H8m8 0v2a2 2 0 01-2 2H10a2 2 0 01-2-2V6m8 0H8"/>`,
  'code': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>`,
  'badge-check': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>`
};
---

<section class="py-8" aria-labelledby="timeline-heading">
  {title && (
    <h2 id="timeline-heading" class="text-2xl font-bold text-gray-900 mb-8 text-center">
      {title}
    </h2>
  )}
  
  <div class="relative max-w-4xl mx-auto">
    <!-- Timeline line -->
    <div class="absolute left-4 md:left-1/2 transform md:-translate-x-px top-0 bottom-0 w-0.5 bg-gray-300 aria-hidden="true"></div>
    
    <!-- Timeline items -->
    <div class="space-y-8">
      {items.map((item, index) => {
        const config = typeConfig[item.type];
        const isEven = index % 2 === 0;
        
        return (
          <div class={`relative flex items-center ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <!-- Timeline marker -->
            <div class="absolute left-4 md:left-1/2 transform md:-translate-x-1/2 flex items-center justify-center">
              <div class={`w-8 h-8 rounded-full border-4 ${config.color} flex items-center justify-center`}>
                <svg class={`w-4 h-4 ${config.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={iconSvg[config.icon]} />
                </svg>
              </div>
            </div>
            
            <!-- Content -->
            <div class={`pl-16 md:pl-0 md:w-1/2 ${isEven ? 'md:pr-8 md:text-right' : 'md:pl-8'}`}>
              <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200
                <!-- Date -->
                <time class="text-sm font-medium text-primary-600 mb-2 block" datetime={item.date}>
                  {item.date}
                </time>
                
                <!-- Title -->
                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  {item.title}
                </h3>
                
                <!-- Description -->
                <p class="text-gray-600 mb-3 leading-relaxed">
                  {item.description}
                </p>
                
                <!-- Details -->
                {item.details && item.details.length > 0 && (
                  <ul class="space-y-1 text-sm text-gray-600 role="list">
                    {item.details.map((detail) => (
                      <li class="flex items-start gap-2">
                        <svg class="w-3 h-3 text-primary-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span>{detail}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
