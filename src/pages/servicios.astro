---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';

// Servicios detallados
const services = [
  {
    title: 'Docencia en centros de formación',
    description: 'Formación técnica especializada adaptada a diferentes modalidades y necesidades educativas.',
    icon: 'teaching',
    features: [
      'Cursos de estudios propios universitarios',
      'Formación INAEM (programas oficiales)',
      'Formación in-company personalizada',
      'Preparación para certificaciones técnicas'
    ],
    details: {
      scope: 'Diseño y impartición de formación técnica en programación, automatización, DevOps y administración de sistemas.',
      deliverables: [
        'Contenidos didácticos personalizados',
        'Ejercicios prácticos y proyectos reales',
        'Evaluaciones y seguimiento del progreso',
        'Material de apoyo y documentación',
        'Certificados de participación'
      ],
      technologies: ['Java', 'Python', 'JavaScript', 'Linux', 'Docker', 'Git', 'AWS'],
      modalities: [
        'Presencial en centros de formación',
        'Online con videoconferencia',
        'Semipresencial (blended learning)',
        'Formación in-company en las instalaciones del cliente'
      ]
    }
  },
  {
    title: 'Automatización y DevOps',
    description: 'Implementación de procesos de integración continua y automatización de infraestructuras.',
    icon: 'deployment',
    features: [
      'CI/CD con GitHub Actions y GitLab',
      'Orquestación con Docker y Kubernetes',
      'Infrastructure as Code',
      'Monitorización y observabilidad'
    ],
    details: {
      scope: 'Automatización completa de procesos de desarrollo, testing y despliegue para equipos de desarrollo.',
      deliverables: [
        'Pipelines CI/CD configurados',
        'Infraestructura como código (Terraform/Ansible)',
        'Contenedorización de aplicaciones',
        'Sistemas de monitorización y alertas',
        'Documentación de procesos'
      ],
      technologies: ['Docker', 'Kubernetes', 'GitHub Actions', 'GitLab CI', 'Terraform', 'Ansible', 'Prometheus', 'Grafana'],
      modalities: [
        'Consultoría e implementación',
        'Auditoría de procesos existentes',
        'Formación de equipos internos',
        'Soporte y mantenimiento continuo'
      ]
    }
  },
  {
    title: 'Mantenimiento de servidores',
    description: 'Administración completa de infraestructuras Linux con enfoque en seguridad y automatización.',
    icon: 'data',
    features: [
      'Administración Linux (Ubuntu, CentOS)',
      'Hardening y seguridad de sistemas',
      'Backups automatizados',
      'Monitorización proactiva'
    ],
    details: {
      scope: 'Gestión integral de servidores Linux, desde la instalación hasta el mantenimiento y optimización continua.',
      deliverables: [
        'Servidores configurados y hardenizados',
        'Sistemas de backup automatizados',
        'Monitorización y alertas 24/7',
        'Documentación de configuraciones',
        'Planes de recuperación ante desastres'
      ],
      technologies: ['Linux', 'Nginx', 'Apache', 'MySQL', 'PostgreSQL', 'Redis', 'Zabbix', 'Fail2ban'],
      modalities: [
        'Administración remota 24/7',
        'Mantenimiento programado',
        'Soporte de emergencias',
        'Migración de servidores'
      ]
    }
  },
  {
    title: 'Desarrollo de aplicaciones',
    description: 'Desarrollo backend robusto y APIs escalables usando tecnologías modernas.',
    icon: 'web',
    features: [
      'APIs REST con Node.js y Python',
      'Data engineering y ETL',
      'Arquitecturas de microservicios',
      'Optimización de bases de datos'
    ],
    details: {
      scope: 'Desarrollo de aplicaciones backend, APIs y sistemas de procesamiento de datos escalables y mantenibles.',
      deliverables: [
        'APIs REST completamente documentadas',
        'Aplicaciones backend escalables',
        'Pipelines de procesamiento de datos',
        'Tests automatizados',
        'Documentación técnica completa'
      ],
      technologies: ['Node.js', 'Python', 'FastAPI', 'Express', 'PostgreSQL', 'MongoDB', 'Redis', 'AWS'],
      modalities: [
        'Desarrollo desde cero',
        'Refactoring y optimización',
        'Migración de sistemas legacy',
        'Code review y consultoría'
      ]
    }
  }
];

// Modalidades de formación
const trainingModalities = [
  {
    title: 'Formación INAEM',
    description: 'Cursos oficiales financiados por el INAEM para desempleados y trabajadores en activo.',
    features: [
      'Certificados oficiales',
      'Financiación pública',
      'Orientación laboral incluida',
      'Prácticas en empresas'
    ]
  },
  {
    title: 'Estudios propios',
    description: 'Programas académicos universitarios de especialización técnica.',
    features: [
      'Títulos universitarios',
      'Metodología académica',
      'Proyectos fin de curso',
      'Evaluación rigurosa'
    ]
  },
  {
    title: 'Formación in-company',
    description: 'Programas formativos adaptados a las necesidades específicas de cada empresa.',
    features: [
      'Contenido personalizado',
      'Horarios flexibles',
      'En las instalaciones del cliente',
      'Seguimiento post-formación'
    ]
  }
];
---

<Base
  title="Servicios - Saúl Moreno"
  description="Servicios especializados en docencia técnica, automatización, DevOps y desarrollo de aplicaciones en Zaragoza"
  keywords="servicios técnicos, docencia INAEM, formación empresas, automatización DevOps, mantenimiento servidores"
>
  <Header slot="header" />
  
  <!-- Page Header -->
  <section class="py-16 bg-gradient-to-r from-primary-50 to-blue-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          Servicios especializados
        </h1>
        <p class="text-xl text-gray-700 mb-8 max-w-3xl mx-auto">
          Combino experiencia técnica en automatización y desarrollo con pasión por la enseñanza, 
          ofreciendo formación de calidad y soluciones tecnológicas robustas.
        </p>
        
        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-2xl mx-auto">
          <div class="text-center">
            <div class="text-3xl font-bold text-gray-900 mb-1">8+</div>
            <div class="text-sm text-gray-700">Años experiencia</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-gray-900 mb-1">530+</div>
            <div class="text-sm text-gray-700">Estudiantes formados</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-gray-900 mb-1">50+</div>
            <div class="text-sm text-gray-700">Proyectos completados</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-gray-900 mb-1">98%</div>
            <div class="text-sm text-gray-700">Satisfacción</div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Detailed Services -->
  <section class="py-16" aria-labelledby="detailed-services">
    <div class="container mx-auto px-4">
      <div class="space-y-16">
        {services.map((service, index) => (
          <div class={`${index % 2 === 0 ? '' : 'bg-gray-50 py-16 -mx-4 px-4 rounded-2xl`}>
            <div class="max-w-6xl mx-auto">
              <div class={`grid lg:grid-cols-2 gap-12 items-start ${index % 2 === 0 ? '' : 'lg:grid-cols-2'}`}>
                <!-- Service Info -->
                <div class={index % 2 === 0 ? '' : 'lg:order-2'}>
                  <ServiceCard {...service} />
                </div>
                
                <!-- Service Details -->
                <div class={index % 2 === 0 ? '' : 'lg:order-1'}>
                  <div class="space-y-8">
                    <!-- Scope -->
                    <div>
                      <h3 class="text-xl font-semibold text-gray-900 mb-4">Alcance del servicio</h3>
                      <p class="text-gray-600 leading-relaxed">
                        {service.details.scope}
                      </p>
                    </div>
                    
                    <!-- Deliverables -->
                    <div>
                      <h3 class="text-xl font-semibold text-gray-900 mb-4">Entregables</h3>
                      <ul class="space-y-2">
                        {service.details.deliverables.map((deliverable) => (
                          <li class="flex items-start gap-2 text-gray-600
                            <svg class="w-4 h-4 text-primary-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                            <span>{deliverable}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    
                    <!-- Technologies -->
                    <div>
                      <h3 class="text-xl font-semibold text-gray-900 mb-4">Tecnologías principales</h3>
                      <div class="flex flex-wrap gap-2">
                        {service.details.technologies.map((tech) => (
                          <span class="px-3 py-1 text-sm bg-primary-100 text-primary-700 rounded-full">
                            {tech}
                          </span>
                        ))}
                      </div>
                    </div>
                    
                    <!-- Modalities -->
                    <div>
                      <h3 class="text-xl font-semibold text-gray-900 mb-4">Modalidades disponibles</h3>
                      <ul class="space-y-2">
                        {service.details.modalities.map((modality) => (
                          <li class="flex items-start gap-2 text-gray-600
                            <svg class="w-4 h-4 text-primary-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                            <span>{modality}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Training Modalities -->
  <section class="py-16 bg-gray-50 aria-labelledby="training-modalities">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 id="training-modalities" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Modalidades de formación
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Diferentes opciones formativas adaptadas a las necesidades de estudiantes, profesionales y empresas.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {trainingModalities.map((modality) => (
          <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-200
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {modality.title}
            </h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              {modality.description}
            </p>
            <ul class="space-y-2">
              {modality.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-gray-600
                  <svg class="w-3 h-3 text-primary-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Certification Preparation -->
  <section class="py-16" aria-labelledby="certifications">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 id="certifications" class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
          Preparación para certificaciones
        </h2>
        <p class="text-xl text-gray-600 mb-8">
          Formación especializada para obtener certificaciones técnicas reconocidas en la industria.
        </p>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {['AWS Solutions Architect', 'Docker Certified Associate', 'Kubernetes Administrator', 'Linux Professional'].map((cert) => (
            <div class="bg-white rounded-lg p-4 border border-gray-200 text-center">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-primary-600 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-gray-900 text-sm">
                {cert}
              </h3>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="py-16 bg-primary-600
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">
        ¿Necesitas alguno de estos servicios?
      </h2>
      <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
        Cada proyecto es único. Contáctame para discutir tus necesidades específicas 
        y crear una propuesta personalizada.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/web-revolut/tarifas/"
          class="bg-white text-primary-600 hover:bg-gray-100 font-semibold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-600 shadow-lg"
        >
          Solicitar presupuesto
        </a>
        <a
          href="/web-revolut/docencia/"
          class="border-2 border-white text-white hover:bg-white hover:text-primary-600 font-semibold py-3 px-8 rounded-lg transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-600"
        >
          Ver experiencia docente
        </a>
      </div>
    </div>
  </section>
  
  <Footer slot="footer" />
</Base>
