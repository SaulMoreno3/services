---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Información de contacto
const contactInfo = {
  email: 'saul.moreno@ejemplo.com', // Cambiar por el em            <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <p class="text-sm text-gray-700">Zaragoza, España</p>
            <p class="font-medium text-gray-900">Base de operaciones</p>
  phone: '+34 612 345 678', // Cambiar por el teléfono real
  location: 'Zaragoza, España',
  availability: 'Disponible para proyectos',
  response_time: '24 horas'
};

// Tipos de servicios con precios orientativos
const serviceTypes = [
  {
    category: 'Docencia y Formación',
    icon: '🎓',
    description: 'Formación técnica especializada presencial y online',
    services: [
      {
        name: 'Curso INAEM (590h)',
        price: 'Según financiación',
        features: [
          'Certificado oficial de profesionalidad',
          'Módulo de prácticas incluido',
          'Orientación laboral',
          'Material didáctico'
        ]
      },
      {
        name: 'Formación in-company',
        price: 'Desde 800€/día',
        features: [
          'Contenido personalizado',
          'Modalidad presencial u online',
          'Evaluación y certificación',
          'Seguimiento post-formación'
        ]
      },
      {
        name: 'Tutoría especializada',
        price: '50€/hora',
        features: [
          'Sesiones individuales',
          'Mentoría técnica',
          'Preparación certificaciones',
          'Resolución de dudas'
        ]
      }
    ]
  },
  {
    category: 'DevOps y Automatización',
    icon: '⚙️',
    description: 'Implementación de procesos CI/CD y automatización',
    services: [
      {
        name: 'Setup CI/CD completo',
        price: 'Desde 2,500€',
        features: [
          'Pipeline automatizado',
          'Testing integrado',
          'Deployment automático',
          'Documentación técnica'
        ]
      },
      {
        name: 'Migración a contenedores',
        price: 'Desde 1,800€',
        features: [
          'Dockerización de aplicaciones',
          'Orquestación con Kubernetes',
          'Configuración de registries',
          'Scripts de automatización'
        ]
      },
      {
        name: 'Consultoría DevOps',
        price: '120€/hora',
        features: [
          'Auditoría de procesos',
          'Diseño de arquitectura',
          'Optimización de workflows',
          'Transferencia de conocimiento'
        ]
      }
    ]
  },
  {
    category: 'Desarrollo Backend',
    icon: '💻',
    description: 'APIs escalables y aplicaciones backend robustas',
    services: [
      {
        name: 'API REST completa',
        price: 'Desde 3,500€',
        features: [
          'Documentación OpenAPI',
          'Autenticación JWT',
          'Testing automatizado',
          'Optimización de rendimiento'
        ]
      },
      {
        name: 'Migración de aplicaciones',
        price: 'Desde 2,800€',
        features: [
          'Análisis de código legacy',
          'Refactoring progresivo',
          'Mejora de arquitectura',
          'Plan de migración'
        ]
      },
      {
        name: 'Desarrollo por horas',
        price: '80€/hora',
        features: [
          'Desarrollo bajo demanda',
          'Code review',
          'Resolución de bugs',
          'Nuevas funcionalidades'
        ]
      }
    ]
  },
  {
    category: 'Administración de Sistemas',
    icon: '🖥️',
    description: 'Gestión y mantenimiento de infraestructura Linux',
    services: [
      {
        name: 'Mantenimiento mensual',
        price: 'Desde 400€/mes',
        features: [
          'Monitorización 24/7',
          'Backups automatizados',
          'Actualizaciones de seguridad',
          'Soporte técnico'
        ]
      },
      {
        name: 'Migración a cloud',
        price: 'Desde 2,200€',
        features: [
          'Análisis de infraestructura',
          'Plan de migración',
          'Configuración cloud',
          'Optimización de costes'
        ]
      },
      {
        name: 'Hardening y seguridad',
        price: 'Desde 1,200€',
        features: [
          'Auditoría de seguridad',
          'Configuración firewall',
          'Políticas de acceso',
          'Monitorización de intrusiones'
        ]
      }
    ]
  }
];

// Factores que influyen en el precio
const pricingFactors = [
  {
    factor: 'Complejidad técnica',
    description: 'Tecnologías involucradas, integración con sistemas existentes',
    impact: 'Alto'
  },
  {
    factor: 'Duración del proyecto',
    description: 'Proyectos de larga duración tienen mejores tarifas',
    impact: 'Medio'
  },
  {
    factor: 'Urgencia',
    description: 'Deadlines ajustados pueden incrementar el coste',
    impact: 'Variable'
  },
  {
    factor: 'Modalidad de trabajo',
    description: 'Remoto, presencial o híbrido',
    impact: 'Bajo'
  }
];

// Proceso de trabajo
const workProcess = [
  {
    step: 1,
    title: 'Análisis inicial',
    description: 'Reunión para entender necesidades y objetivos',
    duration: '1-2 días'
  },
  {
    step: 2,
    title: 'Propuesta técnica',
    description: 'Presupuesto detallado con cronograma',
    duration: '2-3 días'
  },
  {
    step: 3,
    title: 'Desarrollo/Implementación',
    description: 'Ejecución con comunicación regular',
    duration: 'Variable'
  },
  {
    step: 4,
    title: 'Entrega y soporte',
    description: 'Documentación y período de garantía',
    duration: '1 semana'
  }
];
---

<Base
  title="Tarifas y Contacto - Saúl Moreno"
  description="Solicita presupuesto personalizado para servicios de docencia técnica, DevOps, desarrollo backend y administración de sistemas."
  keywords="tarifas servicios técnicos, presupuesto formación, consultoría DevOps, desarrollo backend precios"
>
  <Header slot="header" />
  
  <!-- Page Header -->
  <section class="py-16 bg-gradient-to-r from-green-50 to-blue-50
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          Tarifas y presupuestos
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
          Cada proyecto es único. Estas tarifas son orientativas y se ajustan según 
          las necesidades específicas de tu organización.
        </p>
        
        <!-- Contact Quick Info -->
        <div class="grid md:grid-cols-3 gap-6 max-w-2xl mx-auto">
          <div class="text-center">
            <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6 text-primary-600 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <p class="text-sm text-gray-600 en</p>
            <p class="font-medium text-gray-900
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6 text-primary-600 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <p class="text-sm text-gray-600
            <p class="font-medium text-gray-900
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6 text-primary-600 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <p class="text-sm text-gray-600
            <p class="font-medium text-primary-600
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Services Pricing -->
  <section class="py-16" aria-labelledby="pricing">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 id="pricing" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Tarifas por servicio
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Precios orientativos que varían según la complejidad y duración del proyecto.
        </p>
      </div>
      
      <div class="space-y-16 max-w-7xl mx-auto">
        {serviceTypes.map((category, categoryIndex) => (
          <div class={`${categoryIndex % 2 === 0 ? '' : 'bg-gray-50 p-8 rounded-2xl -mx-4`}>
            <div class="max-w-6xl mx-auto">
              <!-- Category Header -->
              <div class="text-center mb-12">
                <div class="text-5xl mb-4">{category.icon}</div>
                <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
                  {category.category}
                </h3>
                <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                  {category.description}
                </p>
              </div>
              
              <!-- Services Grid -->
              <div class="grid md:grid-cols-3 gap-8">
                {category.services.map((service) => (
                  <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-200 hover:shadow-xl transition-all duration-300">
                    <div class="text-center mb-6">
                      <h4 class="text-xl font-bold text-gray-900 mb-2">
                        {service.name}
                      </h4>
                      <div class="text-3xl font-bold text-primary-600
                        {service.price}
                      </div>
                    </div>
                    
                    <ul class="space-y-3">
                      {service.features.map((feature) => (
                        <li class="flex items-start gap-2 text-gray-600
                          <svg class="w-4 h-4 text-primary-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                          </svg>
                          <span class="text-sm">{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Pricing Factors -->
  <section class="py-16 bg-gray-50 aria-labelledby="factors">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 id="factors" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Factores que influyen en el precio
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Cada presupuesto se personaliza teniendo en cuenta estos aspectos clave.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
        {pricingFactors.map((factor) => (
          <div class="bg-white rounded-xl p-6 shadow-lg border border-gray-200 text-center">
            <h3 class="text-lg font-bold text-gray-900 mb-3">
              {factor.factor}
            </h3>
            <p class="text-gray-600 text-sm mb-4 leading-relaxed">
              {factor.description}
            </p>
            <span class={`px-3 py-1 rounded-full text-xs font-medium ${
              factor.impact === 'Alto' ? 'bg-red-100 text-red-700 :
              factor.impact === 'Medio' ? 'bg-yellow-100 text-yellow-700 :
              'bg-green-100 text-green-700
            }`}>
              Impacto {factor.impact}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Work Process -->
  <section class="py-16" aria-labelledby="process">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 id="process" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Proceso de trabajo
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Metodología clara y transparente desde el primer contacto hasta la entrega final.
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {workProcess.map((step, index) => (
            <div class="text-center relative">
              {/* Connection line */}
              {index < workProcess.length - 1 && (
                <div class="hidden lg:block absolute top-6 left-1/2 w-full h-0.5 bg-primary-200 z-0"></div>
              )}
              
              {/* Step circle */}
              <div class="relative z-10 w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center font-bold text-lg mx-auto mb-4">
                {step.step}
              </div>
              
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {step.title}
              </h3>
              <p class="text-gray-600 text-sm mb-2 leading-relaxed">
                {step.description}
              </p>
              <span class="text-xs text-primary-600 font-medium">
                {step.duration}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <!-- Contact Form -->
  <section class="py-16 bg-primary-50 aria-labelledby="contact-form">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 id="contact-form" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Solicita tu presupuesto
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Cuéntame los detalles de tu proyecto y te enviaré una propuesta personalizada.
          </p>
        </div>
        
        <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-200
          <form action={`mailto:${contactInfo.email}`} method="post" enctype="text/plain" class="space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Name -->
              <div>
                <label for="name" class="block text-sm font-semibold text-gray-900 mb-2">
                  Nombre completo *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-gray-900
                  placeholder="Tu nombre y apellidos"
                />
              </div>
              
              <!-- Email -->
              <div>
                <label for="email" class="block text-sm font-semibold text-gray-900 mb-2">
                  Email *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-gray-900
                  placeholder="tu@email.com"
                />
              </div>
            </div>
            
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Phone -->
              <div>
                <label for="phone" class="block text-sm font-semibold text-gray-900 mb-2">
                  Teléfono
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-gray-900
                  placeholder="+34 612 345 678"
                />
              </div>
              
              <!-- Company -->
              <div>
                <label for="company" class="block text-sm font-semibold text-gray-900 mb-2">
                  Empresa/Organización
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-gray-900
                  placeholder="Nombre de tu empresa"
                />
              </div>
            </div>
            
            <!-- Subject -->
            <div>
              <label for="subject" class="block text-sm font-semibold text-gray-900 mb-2">
                Tipo de servicio *
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-gray-900
              >
                <option value="">Selecciona un servicio</option>
                <option value="Docencia y Formación">Docencia y Formación</option>
                <option value="DevOps y Automatización">DevOps y Automatización</option>
                <option value="Desarrollo Backend">Desarrollo Backend</option>
                <option value="Administración de Sistemas">Administración de Sistemas</option>
                <option value="Consultoría Técnica">Consultoría Técnica</option>
                <option value="Otro">Otro (especificar en mensaje)</option>
              </select>
            </div>
            
            <!-- Message -->
            <div>
              <label for="message" class="block text-sm font-semibold text-gray-900 mb-2">
                Descripción del proyecto *
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-gray-900 resize-none"
                placeholder="Describe tu proyecto: objetivos, tecnologías involucradas, plazos estimados, presupuesto aproximado..."
              ></textarea>
            </div>
            
            <!-- Budget -->
            <div>
              <label for="budget" class="block text-sm font-semibold text-gray-900 mb-2">
                Presupuesto estimado
              </label>
              <select
                id="budget"
                name="budget"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-gray-900
              >
                <option value="">Selecciona un rango (opcional)</option>
                <option value="< 1.000€">Menos de 1.000€</option>
                <option value="1.000€ - 5.000€">1.000€ - 5.000€</option>
                <option value="5.000€ - 10.000€">5.000€ - 10.000€</option>
                <option value="10.000€ - 25.000€">10.000€ - 25.000€</option>
                <option value="> 25.000€">Más de 25.000€</option>
                <option value="A discutir">A discutir</option>
              </select>
            </div>
            
            <!-- Privacy -->
            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="privacy"
                name="privacy"
                required
                class="mt-1 w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500"
              />
              <label for="privacy" class="text-sm text-gray-600
                Acepto que mis datos se utilicen para responder a esta consulta. 
                No serán cedidos a terceros ni utilizados para otros fines. *
              </label>
            </div>
            
            <!-- Submit Button -->
            <div class="text-center pt-4">
              <button
                type="submit"
                class="bg-primary-600 hover:bg-primary-700 text-white font-semibold py-4 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 shadow-lg"
              >
                Enviar solicitud de presupuesto
              </button>
              <p class="text-sm text-gray-600 mt-4">
                Te responderé en un máximo de {contactInfo.response_time}
              </p>
            </div>
          </form>
        </div>
        
        <!-- Alternative Contact -->
        <div class="text-center mt-12">
          <p class="text-gray-600 mb-4">
            ¿Prefieres contactar directamente?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={`mailto:${contactInfo.email}`}
              class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-medium"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {contactInfo.email}
            </a>
            <a
              href={`tel:${contactInfo.phone}`}
              class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-medium"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {contactInfo.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <Footer slot="footer" />
</Base>
