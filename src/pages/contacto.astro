---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Información de contacto
const contactInfo = [
  {
    type: 'email',
    label: 'Email',
    value: 'tu-email@dominio',
    href: 'mailto:tu-email@dominio',
    icon: 'mail',
    description: 'Respuesta en 24-48 horas'
  },
  {
    type: 'location',
    label: 'Ubicación',
    value: 'Zaragoza, España',
    href: 'https://maps.google.com/?q=Zaragoza,España',
    icon: 'location',
    description: 'Disponible para proyectos remotos'
  },
  {
    type: 'phone',
    label: 'Teléfono',
    value: '+34 xxx xxx xxx',
    href: 'tel:+34xxxxxxxxx',
    icon: 'phone',
    description: 'Disponible de 9:00 - 18:00'
  }
];

// Enlaces sociales y profesionales
const socialLinks = [
  {
    name: 'GitHub',
    href: 'https://github.com/TU_USUARIO',
    icon: 'github',
    description: 'Código fuente y proyectos open source'
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/in/saul-preda',
    icon: 'linkedin',
    description: 'Perfil profesional y experiencia laboral'
  },
  {
    name: 'Twitter',
    href: 'https://twitter.com/TU_USUARIO',
    icon: 'twitter',
    description: 'Pensamientos sobre tecnología y educación'
  }
];

// Tipos de colaboración
const collaborationTypes = [
  {
    title: 'Desarrollo de aplicaciones',
    description: 'Aplicaciones web y móviles, APIs REST, arquitecturas escalables',
    icon: 'code',
    examples: ['Aplicaciones web full-stack', 'APIs REST/GraphQL', 'Migración de sistemas legacy']
  },
  {
    title: 'Data Engineering',
    description: 'Pipelines de datos, ETL/ELT, automatización y análisis',
    icon: 'chart-bar',
    examples: ['Pipelines ETL con Airflow', 'Migración de datos', 'Dashboards y reporting']
  },
  {
    title: 'Consultoría técnica',
    description: 'Auditorías de código, arquitectura de software, mejores prácticas',
    icon: 'clipboard-check',
    examples: ['Code review y refactoring', 'Arquitectura de microservicios', 'Optimización de rendimiento']
  },
  {
    title: 'Formación y mentoring',
    description: 'Cursos personalizados, workshops, mentoring para equipos',
    icon: 'academic-cap',
    examples: ['Formación en Java/Node.js', 'Workshops de bases de datos', 'Mentoring de desarrolladores']
  }
];

const iconSvg = {
  mail: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
  location: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
  phone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
  github: `<path fill="currentColor" d="M12 0C5.374 0 0 5.373 0 12 0 17.302 3.438 21.8 8.207 23.387c.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>`,
  linkedin: `<path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
  twitter: `<path fill="currentColor" d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>`,
  code: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>`,
  'chart-bar': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>`,
  'clipboard-check': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>`,
  'academic-cap': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>`
};
---

<Base
  title="Contacto - Saúl Preda"
  description="Contacta conmigo para proyectos de desarrollo de software, consultoría técnica o formación. Respuesta garantizada en 24-48 horas."
  keywords="contacto, colaboración, desarrollo software, consultoría, formación, Zaragoza"
>
  <Header slot="header" />
  
  <!-- Page Header -->
  <section class="py-16 bg-gradient-to-r from-primary-50 to-blue-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          Hablemos
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
          Siempre estoy interesado en nuevos proyectos, colaboraciones y oportunidades. 
          Si tienes una idea o necesitas ayuda técnica, no dudes en contactarme.
        </p>
        
        <!-- Availability Status -->
        <div class="inline-flex items-center gap-2 bg-green-100 text-green-800 px-4 py-2 rounded-full text-sm font-medium">
          <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
          <span>Disponible para nuevos proyectos</span>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Contact Methods -->
  <section class="py-16" aria-labelledby="contact-methods-heading">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 id="contact-methods-heading" class="text-3xl font-bold text-gray-900 mb-4">
          Métodos de contacto
        </h2>
        <p class="text-lg text-gray-600"
          Elige la forma que prefieras para ponerte en contacto conmigo
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto mb-16">
        {contactInfo.map((contact) => (
          <a
            href={contact.href}
            target={contact.type === 'location' ? '_blank' : '_self'}
            rel={contact.type === 'location' ? 'noopener noreferrer' : undefined}
            class="bg-white rounded-xl shadow-lg p-6 border border-gray-200 hover:border-primary-300 transition-all duration-300 transform hover:scale-105 group"
            aria-label={`${contact.label}: ${contact.value}`}
          >
            <div class="text-center">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mx-auto mb-4 group-hover:bg-primary-200 transition-colors">
                <svg class="w-6 h-6 text-primary-600 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <Fragment set:html={iconSvg[contact.icon]} />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                {contact.label}
              </h3>
              <p class="text-primary-600 font-medium mb-2">
                {contact.value}
              </p>
              <p class="text-sm text-gray-500"
                {contact.description}
              </p>
            </div>
          </a>
        ))}
      </div>
      
      <!-- Social Links -->
      <div class="text-center mb-16">
        <h3 class="text-xl font-semibold text-gray-900 mb-6">
          También puedes encontrarme en
        </h3>
        <div class="flex justify-center gap-6">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col items-center gap-2 p-4 rounded-lg hover:bg-gray-50 transition-colors"
              aria-label={`Ver perfil en ${social.name}`}
              title={social.description}
            >
              <div class="w-8 h-8 text-gray-600 group-hover:text-primary-600 transition-colors">
                <svg class="w-full h-full" fill="currentColor" viewBox="0 0 24 24">
                  <Fragment set:html={iconSvg[social.icon]} />
                </svg>
              </div>
              <span class="text-sm font-medium text-gray-700 group-hover:text-primary-600 transition-colors">
                {social.name}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <!-- Contact Form -->
  <section class="py-16 bg-gray-50 aria-labelledby="contact-form-heading">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-12">
          <h2 id="contact-form-heading" class="text-3xl font-bold text-gray-900 mb-4">
            Envíame un mensaje
          </h2>
          <p class="text-lg text-gray-600"
            Completa el formulario y te responderé lo antes posible
          </p>
        </div>
        
        <form 
          id="contact-form"
          class="bg-white rounded-xl shadow-lg p-8 border border-gray-200"
          action="mailto:tu-email@dominio"
          method="POST"
          enctype="text/plain"
        >
          <!-- Name -->
          <div class="mb-6">
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              Nombre completo *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
              placeholder="Tu nombre"
              aria-describedby="name-help"
            />
            <p id="name-help" class="mt-1 text-sm text-gray-500"
              Como te gustaría que me dirija a ti
            </p>
          </div>
          
          <!-- Email -->
          <div class="mb-6">
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
              placeholder="tu@email.com"
              aria-describedby="email-help"
            />
            <p id="email-help" class="mt-1 text-sm text-gray-500"
              Para poder responderte
            </p>
          </div>
          
          <!-- Subject -->
          <div class="mb-6">
            <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">
              Asunto *
            </label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
              aria-describedby="subject-help"
            >
              <option value="">Selecciona un tema</option>
              <option value="desarrollo">Desarrollo de aplicaciones</option>
              <option value="data">Data engineering</option>
              <option value="consultoria">Consultoría técnica</option>
              <option value="formacion">Formación/Mentoring</option>
              <option value="colaboracion">Colaboración/Partnership</option>
              <option value="otro">Otro</option>
            </select>
            <p id="subject-help" class="mt-1 text-sm text-gray-500"
              Ayúdame a categorizar tu consulta
            </p>
          </div>
          
          <!-- Message -->
          <div class="mb-6">
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
              Mensaje *
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
              placeholder="Cuéntame sobre tu proyecto o consulta. Incluye detalles relevantes como tecnologías, plazos, presupuesto aproximado, etc."
              aria-describedby="message-help"
            ></textarea>
            <p id="message-help" class="mt-1 text-sm text-gray-500"
              Cuanto más detallado, mejor podrré ayudarte
            </p>
          </div>
          
          <!-- Budget (optional) -->
          <div class="mb-6">
            <label for="budget" class="block text-sm font-medium text-gray-700 mb-2">
              Presupuesto estimado (opcional)
            </label>
            <select
              id="budget"
              name="budget"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
            >
              <option value="">Prefiero no especificar</option>
              <option value="<1000">Menos de 1.000€</option>
              <option value="1000-5000">1.000€ - 5.000€</option>
              <option value="5000-10000">5.000€ - 10.000€</option>
              <option value="10000+">Más de 10.000€</option>
              <option value="hablemos">Hablemos sobre ello</option>
            </select>
          </div>
          
          <!-- Submit Button -->
          <div class="text-center">
            <button
              type="submit"
              class="bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:ring-offset-2 shadow-lg"
            >
              Enviar mensaje
            </button>
            <p class="mt-3 text-sm text-gray-500"
              Te responderé en un plazo de 24-48 horas
            </p>
          </div>
        </form>
        
        <!-- Form Alternative -->
        <div class="mt-8 text-center">
          <p class="text-gray-600 mb-4">
            ¿Prefieres un contacto más directo?
          </p>
          <a
            href="mailto:tu-email@dominio?subject=Consulta desde tu web"
            class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-medium"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Enviar email directamente
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Collaboration Types -->
  <section class="py-16" aria-labelledby="collaboration-heading">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 id="collaboration-heading" class="text-3xl font-bold text-gray-900 mb-4">
          Formas de colaboración
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Estos son algunos de los tipos de proyectos en los que me especializo
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {collaborationTypes.map((type) => (
          <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-200"
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <Fragment set:html={iconSvg[type.icon]} />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 mb-2">
                  {type.title}
                </h3>
                <p class="text-gray-600 mb-4">
                  {type.description}
                </p>
                <div>
                  <h4 class="text-sm font-medium text-gray-900 mb-2">Ejemplos:</h4>
                  <ul class="space-y-1">
                    {type.examples.map((example) => (
                      <li class="flex items-start gap-2 text-sm text-gray-600"
                        <svg class="w-3 h-3 text-primary-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span>{example}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <Footer slot="footer" />
</Base>

<script>
  // Enhanced form handling
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('contact-form');
    
    if (form) {
      form.addEventListener('submit', function(e) {
        // Basic client-side validation
        const name = document.getElementById('name').value.trim();
        const email = document.getElementById('email').value.trim();
        const subject = document.getElementById('subject').value;
        const message = document.getElementById('message').value.trim();
        
        if (!name || !email || !subject || !message) {
          e.preventDefault();
          alert('Por favor, completa todos los campos obligatorios.');
          return;
        }
        
        // Email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          e.preventDefault();
          alert('Por favor, introduce un email válido.');
          return;
        }
        
        // Prepare mailto link with form data
        const budget = document.getElementById('budget').value;
        const body = `Nombre: ${name}%0D%0AEmail: ${email}%0D%0AAsunto: ${subject}%0D%0A${budget ? `Presupuesto: ${budget}%0D%0A` : ''}%0D%0AMensaje:%0D%0A${message}`;
        
        // Update form action with complete data
        this.action = `mailto:tu-email@dominio?subject=Consulta web: ${subject}&body=${body}`;
      });
    }
    
    // Auto-resize textarea
    const textarea = document.getElementById('message');
    if (textarea) {
      textarea.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = (this.scrollHeight) + 'px';
      });
    }
  });
</script>
