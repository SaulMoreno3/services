---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';

const base = import.meta.env.BASE_URL;

// Proyectos completos organizados por categorías
const projects = [
  {
    title: 'Plataforma de Automatización DevOps',
    description: 'Sistema completo de CI/CD para startup tecnológica con microservicios. Incluye monitoring avanzado, escalado automático y gestión de recursos cloud.',
    features: [
      'Infrastructure as Code con Terraform',
      'Pipeline CI/CD con testing automatizado',
      'Monitorización con Prometheus y Grafana',
      'Auto-scaling y gestión de recursos',
      'Backup automatizado multi-región',
      'Security scanning integrado'
    ],
    stack: ['Docker', 'Kubernetes', 'GitLab CI', 'Terraform', 'AWS', 'Prometheus'],
    category: 'DevOps',
    status: 'completed' as const,
    demoUrl: 'https://demo.devops-platform.com',
    membershipUrl: `${base}tarifas/#membresia-proyectos`
  },
  {
    title: 'API REST para Gestión de Inventarios',
    description: 'Backend escalable para sistema de inventarios de empresa logística. Maneja más de 10,000 transacciones diarias con alta disponibilidad.',
    features: [
      'API RESTful con documentación OpenAPI',
      'Caché distribuido con Redis',
      'Testing comprehensivo (95% coverage)',
      'Optimización de consultas SQL',
      'Rate limiting y autenticación JWT',
      'Logging estructurado y métricas'
    ],
    stack: ['Node.js', 'Express', 'PostgreSQL', 'Redis', 'Docker', 'Jest'],
    category: 'Backend',
    status: 'completed' as const,
    demoUrl: 'https://api.inventory-system.com/docs',
    membershipUrl: `${base}tarifas/#membresia-proyectos`
  },
  {
    title: 'Sistema de Monitorización de Servidores',
    description: 'Dashboard personalizado para monitorización de infraestructura empresarial. Reduce el downtime no planificado en un 60%.',
    features: [
      'Alertas en tiempo real vía Slack/Email',
      'Dashboard responsive con métricas clave',
      'Recolección de datos con agentes Python',
      'Históricos y análisis de tendencias',
      'Detección de anomalías con ML',
      'Integración con múltiples proveedores cloud'
    ],
    stack: ['Python', 'FastAPI', 'React', 'InfluxDB', 'Grafana', 'TensorFlow'],
    category: 'Sistemas',
    status: 'completed' as const,
    demoUrl: 'https://monitoring.demo.com',
    membershipUrl: `${base}tarifas/#membresia-proyectos`
  },
  {
    title: 'Automatización de Procesos Académicos',
    description: 'Scripts Python para automatizar tareas administrativas en centro de formación. Ahorra 20 horas semanales de trabajo manual.',
    features: [
      'Generación automática de informes',
      'Sincronización de datos entre sistemas',
      'Notificaciones automáticas a estudiantes',
      'Backup automatizado de calificaciones',
      'Integración con sistemas LMS',
      'Dashboard de métricas académicas'
    ],
    stack: ['Python', 'Pandas', 'Selenium', 'SQLite', 'Cron', 'Moodle API'],
    category: 'Automatización',
    status: 'completed' as const,
    membershipUrl: `${base}tarifas/#membresia-proyectos`
  },
  {
    title: 'Portal de Cursos Online',
    description: 'Plataforma educativa con gestión de contenidos y seguimiento de progreso. Sirve a más de 500 estudiantes activos mensualmente.',
    features: [
      'Sistema de autenticación y roles',
      'Seguimiento de progreso personalizado',
      'Integración con sistemas de pago',
      'Dashboard de analytics para instructores',
      'Videoconferencias integradas',
      'Sistema de certificaciones digitales'
    ],
    stack: ['Next.js', 'TypeScript', 'Prisma', 'PostgreSQL', 'Stripe', 'WebRTC'],
    category: 'Web',
    status: 'completed' as const,
    demoUrl: 'https://cursos.demo.com',
    membershipUrl: `${base}tarifas/#membresia-proyectos`
  },
  {
    title: 'Migración Cloud de Infraestructura',
    description: 'Migración completa de servidores on-premise a AWS con alta disponibilidad. Reduce costes de infraestructura en un 40%.',
    features: [
      'Arquitectura multi-región con failover',
      'Automatización completa con Terraform',
      'Backup y disaster recovery',
      'Optimización de costes con reserved instances',
      'Security compliance (SOC2, ISO27001)',
      'Monitoring y alerting avanzado'
    ],
    stack: ['AWS', 'Terraform', 'Ansible', 'Docker', 'Route53', 'CloudWatch'],
    category: 'DevOps',
    status: 'completed' as const,
    membershipUrl: `${base}tarifas/#membresia-proyectos`
  },
  {
    title: 'Pipeline de Machine Learning',
    description: 'Sistema de ML para análisis predictivo en empresa fintech. Automatiza la detección de fraude y análisis de riesgo crediticio.',
    features: [
      'Pipeline de datos automatizado',
      'Modelos de ML en producción',
      'A/B testing para modelos',
      'Monitorización de deriva de datos',
      'API de inferencia en tiempo real',
      'Reentrenamiento automatizado'
