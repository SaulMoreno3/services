    stack: ['Python', 'MLflow', 'Apache Airflow', 'PostgreSQL', 'Docker', 'Kubernetes'],
    category: 'Backend',
    status: 'in-progress' as const,
    membershipUrl: '/services/tarifas/#membresia-proyectos'
  },
  {
    title: 'Plataforma de IoT Industrial',
    description: 'Sistema de recolección y análisis de datos de sensores industriales. Optimiza el mantenimiento predictivo de maquinaria.',
    features: [
      'Ingesta de datos en tiempo real',
      'Análisis predictivo de fallos',
      'Dashboard de control industrial',
      'Alertas automáticas de mantenimiento',
      'Integración con sistemas ERP',
      'Edge computing para latencia mínima'
    ],
    stack: ['Python', 'InfluxDB', 'Grafana', 'MQTT', 'Docker', 'Raspberry Pi'],
    category: 'Sistemas',
    status: 'planned' as const,
    membershipUrl: '/services/tarifas/#membresia-proyectos'
  }
];

// Categorías de proyectos
const categories = [
  { name: 'Todos', value: 'all' },
  { name: 'DevOps', value: 'DevOps' },
  { name: 'Backend', value: 'Backend' },
  { name: 'Sistemas', value: 'Sistemas' },
  { name: 'Web', value: 'Web' },
  { name: 'Automatización', value: 'Automatización' }
];

// Estadísticas de proyectos
const stats = [
  {
    metric: '50+',
    label: 'Proyectos completados',
    description: 'En diferentes tecnologías y sectores'
  },
  {
    metric: '15+',
    label: 'Tecnologías dominadas',
    description: 'Stack completo actualizado'
  },
  {
    metric: '98%',
    label: 'Satisfacción del cliente',
    description: 'Basado en feedback recibido'
  },
  {
    metric: '24h',
    label: 'Tiempo respuesta medio',
    description: 'Para resolución de incidencias'
  }
];

// Tecnologías más utilizadas
const topTechnologies = [
  { name: 'Python', count: 6, icon: '🐍' },
  { name: 'Docker', count: 7, icon: '🐳' },
  { name: 'PostgreSQL', count: 4, icon: '🐘' },
  { name: 'AWS', count: 3, icon: '☁️' },
  { name: 'Node.js', count: 2, icon: '💚' },
  { name: 'Terraform', count: 3, icon: '🏗️' },
  { name: 'Kubernetes', count: 3, icon: '⚓' },
  { name: 'Grafana', count: 3, icon: '📊' }
];
---

<Base
  title="Proyectos - Saúl Moreno"
  description="Portfolio de proyectos técnicos especializados en DevOps, desarrollo backend y automatización de sistemas. Acceso mediante membresía."
  keywords="proyectos DevOps, desarrollo backend, automatización, infraestructura cloud, portfolio técnico, membresía"
>
  <Header slot="header" />
  
  <!-- Page Header -->
  <section class="py-16 bg-gradient-to-r from-indigo-50 to-purple-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          Portfolio de proyectos
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
          Selección de proyectos técnicos que demuestran experiencia en automatización, 
          desarrollo backend, DevOps y administración de sistemas. <strong>Acceso disponible mediante membresía.</strong>
        </p>
        
        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto">
          {stats.map((stat) => (
            <div class="text-center">
              <div class="text-3xl font-bold text-primary-600 mb-1">
                {stat.metric}
              </div>
              <div class="text-sm font-medium text-gray-900 mb-1">
                {stat.label}
              </div>
              <div class="text-xs text-gray-600">
                {stat.description}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <!-- Category Filters -->
  <section class="py-8 bg-white border-b border-gray-200">
    <div class="container mx-auto px-4">
      <div class="text-center">
        <h2 class="text-lg font-semibold text-gray-900 mb-6">
          Filtrar por categoría
        </h2>
        <div class="flex flex-wrap justify-center gap-3">
          {categories.map((category, index) => (
            <button 
              class={`px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 border focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 ${
                index === 0 
                  ? 'bg-primary-500 text-white border-primary-500' 
                  : 'border-gray-300 text-gray-700 hover:border-primary-500 hover:text-primary-600'
              }`}
              data-category={category.value}
            >
              {category.name}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <!-- Projects Grid -->
  <section class="py-16" aria-labelledby="projects-grid">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <div class="bg-gradient-to-r from-purple-100 to-blue-100 border border-purple-200 rounded-lg p-6 max-w-2xl mx-auto">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">🔒 Acceso mediante membresía</h3>
          <p class="text-gray-600 mb-4">
            Los proyectos completos, código fuente y documentación están disponibles 
            para miembros. Incluye tutoriales paso a paso y soporte técnico.
          </p>
          <a
            href={`${base}tarifas/#membresia-proyectos`}
            class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-300"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            Información de membresía
          </a>
        </div>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto" id="projects-container">
        {projects.map((project) => (
          <div data-category={project.category}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Technologies Section -->
  <section class="py-16 bg-gray-50" aria-labelledby="technologies">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 id="technologies" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Tecnologías más utilizadas
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Stack tecnológico con el que tengo más experiencia práctica en proyectos reales.
        </p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-6 max-w-6xl mx-auto">
        {topTechnologies.map((tech) => (
          <div class="text-center bg-white rounded-xl p-4 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
            <div class="text-3xl mb-2">{tech.icon}</div>
            <h3 class="font-semibold text-gray-900 text-sm mb-1">
              {tech.name}
            </h3>
            <p class="text-xs text-gray-600">
              {tech.count} proyectos
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Collaboration CTA -->
  <section class="py-16 bg-primary-600">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">
        ¿Tienes un proyecto en mente?
      </h2>
      <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
        Especializado en automatización, DevOps y desarrollo backend. 
        Contáctame para discutir cómo puedo ayudarte con tu próximo proyecto.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${base}tarifas/`}
          class="bg-white text-primary-600 hover:bg-gray-100 font-semibold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-600 shadow-lg"
        >
          Solicitar presupuesto
        </a>
        <a
          href={`${base}servicios/`}
          class="border-2 border-white text-white hover:bg-white hover:text-primary-600 font-semibold py-3 px-8 rounded-lg transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-600"
        >
          Ver servicios
        </a>
      </div>
    </div>
  </section>
  
  <Footer slot="footer" />
</Base>

<script>
  // Category filtering functionality
  document.addEventListener('DOMContentLoaded', () => {
    const categoryButtons = document.querySelectorAll('[data-category]');
    const projectContainer = document.getElementById('projects-container');
    const projectCards = projectContainer?.querySelectorAll('[data-category]');
    
    categoryButtons.forEach(button => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category');
        
        // Update active button
        categoryButtons.forEach(btn => {
          btn.classList.remove('bg-primary-500', 'text-white', 'border-primary-500');
          btn.classList.add('border-gray-300', 'text-gray-700', 'hover:border-primary-500', 'hover:text-primary-600');
        });
        
        button.classList.add('bg-primary-500', 'text-white', 'border-primary-500');
        button.classList.remove('border-gray-300', 'text-gray-700', 'hover:border-primary-500', 'hover:text-primary-600');
        
        // Filter projects
        if (projectCards) {
          projectCards.forEach(card => {
            if (category === 'all' || card.getAttribute('data-category') === category) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        }
      });
    });
  });
</script>
